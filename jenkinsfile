pipeline {
    agent any
  
      tools {
        jfrog 'jfrog-cli'
      }

    options {
        skipDefaultCheckout(true)
    }

    stages {
        stage('Checkout') {
            steps {
                deleteDir()
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/master']],
                    extensions: [[$class: 'CloneOption', depth: 1, noTags: true, shallow: true]],
                    userRemoteConfigs: [[url: 'https://github.com/Patil-Atharva20/Petclinic.git']]
                ])
            }
        }

        stage('snyk scan') {
            steps {
                snykSecurity(
                    snykInstallation: 'snyk@latest',
                    snykTokenId: 'snyk_api_token',
                    monitorProjectOnBuild: false,
                    failOnIssues: false,  // Use boolean for failOnIssues
                )
            }
        }

        stage('maven build artifact') {
            steps {
              // jf 'mvn-config --petclinic_artifact-libs-release --petclinic_artifact-libs-snapshot --petclinic_artifact-libs-release-local --petclinic_artifact-libs-snapshot-local'

                 sh 'rm -f all-vulnerabilities.json'
                 sh './mvnw clean package -DskipTests=true'
            }
        }

        





       stage('TRIVY FS SCAN') {
            steps {
                sh "trivy fs . > trivyfs.txt"
            }
        }

       stage('building a docker image') {
            steps {
                sh "docker build -t atharvapati/petapp:${BUILD_NUMBER} ."
            }
        }

       stage("TRIVY"){
            steps{
                sh "trivy image  atharvapati/petapp:${BUILD_NUMBER} --scanners vuln > trivyimage.txt" 
            }
        }

        stage('docker image push') {
            steps {
                withDockerRegistry(credentialsId: 'dockercred', url: '') {
                    sh "docker push atharvapati/petapp:${BUILD_NUMBER}"
                }
            }
        }


        stage('Publish build info') {
            steps {
                jf 'rt build-publish'
            }
        }

       stage('push artifact') {
            steps {
              jf 'rt u ${WORKSPACE}/target/spring-petclinic-3.2.0-SNAPSHOT.jar petclinic_artifact-libs-snapshot-local/springpetclinic/spring-petclinic-3.2.0-SNAPSHOT.jar'


            }
        }


     



        
    }
}
